# Copy this file to .env locally. Never commit actual secrets.
# Optional: increases The Muse API rate limits.
MUSE_API_KEY=
# Required only to show live salary estimates from Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Required for trusted admins to register official company eligibility criteria.
ADMIN_API_KEY=replace-with-a-long-random-secret
# Optional only if you host the frontend separately.
ALLOWED_ORIGINS=
# Optional: use a mounted persistent path in production.
DATABASE_PATH=
