# Copy to .env for reference only. Configure these values in your shell or host dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace-with-a-long-random-secret
# Use true for an HTTPS deployment such as Render.
COOKIE_SECURE=false
# Only for local UI testing; keep false in production.
ENABLE_DEV_LOGIN=false
# Primary live job provider.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional fallback provider key, but its public endpoint works for limited development use.
MUSE_API_KEY=
# Required to write verified company requirements.
ADMIN_API_KEY=replace-with-a-different-long-random-secret
DATABASE_PATH=
ALLOWED_ORIGINS=
